+def _prefill_yield_from_env() -> tuple[bool, float]:
+    """Prefill yield settings from the environment.
+
+    ``VLLM_PREFILL_YIELD=short`` enables it; unset or any other value leaves
+    scheduling stock. ``VLLM_PREFILL_YIELD_LIMIT_S`` (default 10) is how long a
+    long prefill may keep yielding before its next chunk runs regardless.
+    """
+    enabled = os.environ.get("VLLM_PREFILL_YIELD", "off").strip().lower() == "short"
+    raw = os.environ.get("VLLM_PREFILL_YIELD_LIMIT_S", "10")
+    try:
+        limit_s = float(raw)
+    except (TypeError, ValueError):
+        limit_s = 10.0
+    if not limit_s > 0 or limit_s != limit_s:  # non-positive or NaN
+        limit_s = 10.0
+    return enabled, limit_s
+
