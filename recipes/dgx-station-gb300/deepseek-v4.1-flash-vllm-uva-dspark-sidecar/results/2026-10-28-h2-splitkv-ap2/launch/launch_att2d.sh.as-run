#!/usr/bin/env bash
# launch_att2d.sh -- Card W9 (desk 2026-10-28, claude-opus-5-5): att2c launch_att2b.sh + ADDED-ONLY lines. MAPTRACE=1 mounts the
#   env-gated att2d_maptrace tracer (site-packages .pth + module, sha256-checked) and its dump dir MT_OUT -> /maptrace;
#   NOCORE=1 = no core of any kind (--ulimit core=0 + CUDA GPU/CPU coredump-on-exception explicitly 0; refuses COREDUMP=1).
#   MAPTRACE/NOCORE unset = docker argv byte-identical to att2c launch_att2b.sh.
# att2c / Card W7 (desk 2026-10-28, claude-opus-5-5): launch_att2b.sh + ADDED-ONLY lines: ATT2B=1 passes the CRASH2 quarantine/debug
#   knobs SPLITKV_SQ / SPLITKV_TRACE / SPLITKV_GUARD as VLLM_DSV41_MEGA_SPLITKV_{SQ,TRACE,GUARD} ONLY when set (unset = att2b argv).
#   The card passes B2D=~/dsv41/m3/att2c (overlay + side .so + cores from att2c; the B2D default line is unchanged).
# launch_att2b.sh -- Card W6 (desk 2026-10-28, claude-opus-5-5): launch_att2.sh + ONE block (ATT2B=1: SIDE extension _flashmla_splitkv_C mounted as an EXTRA file
#   next to the shipped vllm/_flashmla_C.abi3.so (never over it) + att2b 2-file overlay + split-KV env + CUDA coredump env). ATT2/ATT2B unset = byte-identical docker args to launch_p3.sh.
# launch_att2.sh -- DRAFT (Milo desk 2026-10-27): launch_p3.sh + ONE block (ATT2=1: rebuilt _flashmla_C .so + 2-file overlay + split-KV env). ATT2 unset = byte-identical docker args to launch_p3.sh.
# launch_br1.sh — Card BR1 variant of launch_sidecar.sh (2026-10-25, Milo desk): identical except SPEC_EXTRA, spliced into the
# --speculative-config JSON before its closing brace. Empty = byte-identical production args; arm B: SPEC_EXTRA=',"rejection_sample_method":"block"'.
# launch_sidecar.sh — DeepSeek-V4.1-Flash-1017 on ONE DGX Station GB300: hot experts in GB300 HBM (MegaMoE, el8 hook),
# cold experts COMPUTED on the RTX PRO 6000 Max-Q via original-el8's /dev/shm "peer tier 2" sidecar (b12x kernels).
# Derived from ~/dsv41/m3/launch_m3g.sh (our Grace-only M3G lane, Card M3G 2026-10-17) and RonanLabsAI
# dgx-station-frontier recipes/dsv41-flash-sidecar/launch/launch-dsv41-sidecar.sh (Apache-2.0). Card SC0, 2026-10-21 (Milo).
# Usage:  launch_sidecar.sh sidecar     # starts the RTX side, waits for "serving"
#         launch_sidecar.sh server      # starts the GB300 vLLM server (requires sidecar serving)
# Bring-up gate: MEGA_PEER_CHECK=100000 MEGA_COLD_TRT=1 launch_sidecar.sh server   (every layer cos >= 0.999 on real prompts)
# PEER_SPINS (default 2e9 since 2026-10-22; el8 default 2e7): GB300 spin limit while waiting on the sidecar. On expiry the
# hook SKIPS the cold add (wrong tokens), so production keeps it effectively unbounded: a dead sidecar hangs, the watchdog rolls back.
# RTX is reached through CDI (nvidia.com/gpu=<UUID>); legacy --gpus cannot see it on DGX OS (dgx-desktop-docker-gpus policy).
set -euo pipefail
STEP=${1:?usage: launch_sidecar.sh sidecar|server}
NAME=${NAME:-dsv41-vllm-SC0-sidecar-EXP}
SCNAME=${SCNAME:-${NAME}-rtx}
IMAGE=${IMAGE:-vllm/vllm-openai@sha256:3af6a45b060d681aa6254200f87859d1bb3c1f962afb3d15540b4b31d4a41063}   # = nightly-af7f9488 (backup: /models/ark-stage/images)
MODEL=${MODEL:-/models/DeepSeek-V4.1-Flash-1017-1bae0e1088993b9b82de08f59de5be5a34e42170}
W=~/dsv41/m3
HOOK=${HOOK:-$W/el8/deepseek-v4.1-flash/m3/hook}   # H1: arm C points this at a versioned copy (hook-h1); default = production
B12X=~/dsv41/b12x            # local-inference-lab/b12x @2cc7f66a
CACHE=~/dsv41/cache-a
GB300=GPU-1c1855c8-dd10-0247-583e-3c3880ddbf55
RTX=GPU-d07eb6e6-7053-42a7-6811-7bb833266182
SEQS=${SEQS:-32}
NSPEC=${NSPEC:-5}
KSCHED=${KSCHED:-"[[1,4,5],[5,8,3],[9,$SEQS,3]]"}
CG_SIZES=${CG_SIZES:-"1 2 4 6 8 12 16 18 20 24 28 32 36 40 48 56 64 72 80 96 128"}
ROWMAP=${ROWMAP:-rowmap-static-v1.json}   # ours: uniform 295 hot / 89 cold. Positive control: rowmap-mix-v1.json (285/99)
GPU_UTIL=${GPU_UTIL:-0.97}
MAXLEN=${MAXLEN:-1048576}
PORT=${PORT:-30006}
EXTRA=${EXTRA:-}
SPEC_EXTRA=${SPEC_EXTRA:-}
LOGDIR=$W/logs
mkdir -p "$CACHE"/{vllm,tilelang,triton,nv,dj,fi,b12x} "$W/prof" "$LOGDIR" "$W/local"
test -f "$MODEL/config.json" || { echo "MODEL MISSING: $MODEL"; exit 3; }
test -f "$HOOK/$ROWMAP" || { echo "ROWMAP MISSING: $HOOK/$ROWMAP"; exit 3; }
docker image inspect "$IMAGE" >/dev/null 2>&1 || { echo "IMAGE MISSING: $IMAGE"; exit 3; }

if [ "$STEP" = sidecar ]; then
  USED=$(nvidia-smi --id="$RTX" --query-gpu=memory.used --format=csv,noheader,nounits | tr -d ' ')
  [ "${USED:-99999}" -lt 2048 ] || { echo "RTX busy (${USED} MiB): stop whatever runs on it first"; exit 4; }
  test -f "$B12X/b12x/moe/fused_moe/api.py" || { echo "b12x checkout missing at $B12X"; exit 3; }
  test -f "$W/local/peer_server2_local.py" || { echo "peer_server2_local.py missing"; exit 3; }
  rm -f /dev/shm/vllm_peer_tier2 2>/dev/null || true   # stale buffer would be opened without O_CREAT by the GB300 side
  docker rm -f "$SCNAME" 2>/dev/null || true
  docker run -d --name "$SCNAME" --device nvidia.com/gpu="$RTX" --ipc host --network host --cap-add SYS_NICE \
    --ulimit memlock=-1 --cap-add IPC_LOCK --security-opt label=disable \
    -v "$MODEL":/model:ro -v "$HOOK":/w:ro -v "$B12X":/b12x:ro -v "$W/local":/sc:ro -v "$LOGDIR":/logs \
    -v "$CACHE/b12x":/root/.cache -v /usr/bin/numactl:/usr/local/bin/numactl:ro \
    -e PYTHONPATH=/b12x -e CUDA_DEVICE_ORDER=PCI_BUS_ID -e HF_HUB_OFFLINE=1 --entrypoint bash "$IMAGE" -c \
    "python3 -c 'import b12x.moe.fused_moe as fm; print(\"b12x ok\", fm.PackedSourceFormat(\"fp4_e8m0_k32\"))' && \
     exec numactl --membind=0 python3 /sc/peer_server2_local.py --rowmap /w/$ROWMAP --model /model" >/dev/null
  nohup docker logs -f "$SCNAME" > "$LOGDIR/peer_server2.log" 2>&1 &
  echo "sidecar $SCNAME starting on RTX $RTX rowmap=$ROWMAP; waiting for 'serving' (Ronan: 40 layers in 45 s, 560 graphs, ~76 GB at 99 cold)"
  for i in $(seq 1 120); do
    if grep -q "^serving" "$LOGDIR/peer_server2.log" 2>/dev/null; then
      tail -3 "$LOGDIR/peer_server2.log"; ls -la /dev/shm/vllm_peer_tier2
      nvidia-smi --id="$RTX" --query-gpu=memory.used,power.draw --format=csv,noheader; exit 0
    fi
    docker ps -q -f name="^${SCNAME}$" | grep -q . || { echo "sidecar died"; tail -30 "$LOGDIR/peer_server2.log"; exit 1; }
    sleep 5
  done
  echo "sidecar not serving after 10 min"; tail -30 "$LOGDIR/peer_server2.log"; exit 1
fi

[ "$STEP" = server ] || { echo "usage: sidecar|server"; exit 2; }
grep -q "^serving" "$LOGDIR/peer_server2.log" 2>/dev/null || { echo "sidecar not serving; run: $0 sidecar"; exit 4; }
docker ps -q -f name="^${SCNAME}$" | grep -q . || { echo "sidecar container $SCNAME not running"; exit 4; }
USED=$(nvidia-smi --id="$GB300" --query-gpu=memory.used --format=csv,noheader,nounits | tr -d ' ')
[ "${USED:-99999}" -lt 8192 ] || { echo "GB300 busy (${USED} MiB)"; exit 4; }
# vllm#58132 overlay (five files) — same tree as launch_m3g.sh; REPLAY_OVERLAY=0 drops it
MOUNT_ARGS=()
if [ "${REPLAY_OVERLAY:-1}" = 1 ]; then
  O=$W/overlay-58132/tree/vllm; D=/usr/local/lib/python3.12/dist-packages/vllm
  for f in config/cache.py models/deepseek_v41/decoder_replay_layers.py models/deepseek_v41/nvidia/model.py \
           models/deepseek_v41/nvidia/model_state.py models/deepseek_v41/nvidia/vl_model.py; do
    [ -f "$O/$f" ] || { echo "overlay file missing: $O/$f" >&2; exit 2; }
    MOUNT_ARGS+=(-v "$O/$f:$D/$f:ro")
  done
fi
# vllm#61161 backport (block-verification fresh draws) -- OVERLAY_61161=1 enables; default off (= production)
if [ "${OVERLAY_61161:-0}" = 1 ]; then
  O61=${O61:-$W/desk-hook/L3/tree/vllm}; D=/usr/local/lib/python3.12/dist-packages/vllm
  for f in v1/worker/gpu/sample/gumbel.py v1/worker/gpu/spec_decode/rejection_sampler_utils.py \
           v1/worker/gpu/spec_decode/dflash2/speculator.py; do
    [ -f "$O61/$f" ] || { echo "overlay-61161 file missing: $O61/$f" >&2; exit 2; }
    MOUNT_ARGS+=(-v "$O61/$f:$D/$f:ro")
  done
  ( cd "$O61/.." && sha1sum -c SHA1SUMS ) >&2 || { echo "overlay-61161 sha1 mismatch" >&2; exit 2; }
fi
# ATT2 split-KV MegaAttn (FlashMLA-fork PR #25 rebuilt as vllm/_flashmla_C + vLLM #57711 + compress_ratio gate) -- ATT2=1
# enables; default off (= production). SPLITKV=4|8 sets VLLM_DSV41_MEGA_SPLITKV (0 = new .so + overlay, split off).
if [ "${ATT2:-0}" = 1 ]; then
  A2D=${A2D:-$W/att2}; D=/usr/local/lib/python3.12/dist-packages/vllm
  [ -f "$A2D/build/out/_flashmla_C.abi3.so" ] || { echo "ATT2 .so missing: $A2D/build/out/_flashmla_C.abi3.so" >&2; exit 2; }
  ( cd "$A2D/build/out" && sha256sum -c SHA256SUMS ) >&2 || { echo "ATT2 .so sha256 mismatch" >&2; exit 2; }
  ( cd "$A2D/overlay" && sha256sum -c SHA256SUMS ) >&2 || { echo "ATT2 overlay sha256 mismatch" >&2; exit 2; }
  MOUNT_ARGS+=(-v "$A2D/build/out/_flashmla_C.abi3.so:$D/_flashmla_C.abi3.so:ro")
  for f in models/deepseek_v41/nvidia/flash_mla_mega_attn.py models/deepseek_v41/nvidia/mega_splitkv_combine.py; do
    MOUNT_ARGS+=(-v "$A2D/overlay/vllm/$f:$D/$f:ro")
  done
  MOUNT_ARGS+=(-e VLLM_DSV41_MEGA_SPLITKV="${SPLITKV:-0}" -e VLLM_DSV41_MEGA_SPLITKV_MAX_TOKENS="${SPLITKV_MAX_TOKENS:-8}"
               -e VLLM_DSV41_MEGA_SPLITKV_SWA="${SPLITKV_SWA:-0}" -e VLLM_DSV41_MEGA_SPLITKV_STRICT=1)
fi
# ATT2b (Card W6) -- ATT2B=1: PR #25 + W5 guards + NaN-safe store built as the SIDE extension _flashmla_splitkv_C, mounted as
# an EXTRA file; the shipped vllm/_flashmla_C.abi3.so stays the image's own and serves every unsplit call. SPLITKV=0 (arm
# S1) = side .so preloaded, split off; SPLITKV=4 (arm S2) = split decode calls on the side op. COREDUMP=1 (default):
# CUDA lightweight GPU core dump on exception into $B2D/cores (names the faulting kernel if anything faults).
if [ "${ATT2B:-0}" = 1 ]; then
  [ "${ATT2:-0}" = 1 ] && { echo "ATT2=1 and ATT2B=1 are exclusive (ATT2 mounts a whole-.so replacement)" >&2; exit 2; }
  B2D=${B2D:-$W/att2b}; D=/usr/local/lib/python3.12/dist-packages/vllm
  SIDE=$B2D/build/out/_flashmla_splitkv_C.abi3.so
  [ -f "$SIDE" ] || { echo "ATT2b side .so missing: $SIDE" >&2; exit 2; }
  ( cd "$B2D/build/out" && sha256sum -c SHA256SUMS ) >&2 || { echo "ATT2b side .so sha256 mismatch" >&2; exit 2; }
  ( cd "$B2D/overlay" && sha256sum -c SHA256SUMS ) >&2 || { echo "ATT2b overlay sha256 mismatch" >&2; exit 2; }
  MOUNT_ARGS+=(-v "$SIDE:$D/_flashmla_splitkv_C.abi3.so:ro")
  for f in models/deepseek_v41/nvidia/flash_mla_mega_attn.py models/deepseek_v41/nvidia/mega_splitkv_combine.py; do
    MOUNT_ARGS+=(-v "$B2D/overlay/vllm/$f:$D/$f:ro")
  done
  MOUNT_ARGS+=(-e VLLM_DSV41_MEGA_SPLITKV="${SPLITKV:-0}" -e VLLM_DSV41_MEGA_SPLITKV_MAX_TOKENS="${SPLITKV_MAX_TOKENS:-8}"
               -e VLLM_DSV41_MEGA_SPLITKV_SWA="${SPLITKV_SWA:-0}" -e VLLM_DSV41_MEGA_SPLITKV_STRICT=1
               -e VLLM_DSV41_MEGA_SPLITKV_SO="$D/_flashmla_splitkv_C.abi3.so"
               -e VLLM_DSV41_MEGA_SPLITKV_MAX_REQS="${SPLITKV_MAX_REQS:-2}" -e VLLM_DSV41_MEGA_SPLITKV_PRELOAD=1)
  # CRASH2 (att2c): SQ = decode s_q allow-list ("" = any; overlay default 6), TRACE = one log line per distinct gate decision,
  # GUARD = sentinel bands around the split partial pool (host-synced checks). Each passed only when set.
  if [ -n "${SPLITKV_SQ+x}" ]; then MOUNT_ARGS+=(-e VLLM_DSV41_MEGA_SPLITKV_SQ="$SPLITKV_SQ"); fi
  if [ -n "${SPLITKV_TRACE:-}" ]; then MOUNT_ARGS+=(-e VLLM_DSV41_MEGA_SPLITKV_TRACE="$SPLITKV_TRACE"); fi
  if [ -n "${SPLITKV_GUARD:-}" ]; then MOUNT_ARGS+=(-e VLLM_DSV41_MEGA_SPLITKV_GUARD="$SPLITKV_GUARD"); fi
  if [ "${COREDUMP:-1}" = 1 ]; then
    mkdir -p "$B2D/cores"
    MOUNT_ARGS+=(-v "$B2D/cores:/att2b-cores" -e CUDA_ENABLE_COREDUMP_ON_EXCEPTION=1
                 -e CUDA_ENABLE_LIGHTWEIGHT_COREDUMP=1 -e "CUDA_COREDUMP_FILE=/att2b-cores/core.${NAME}.%p.%t")
  fi
fi
# ATT2D (Card W9) -- MAPTRACE=1: allocator/mapping snapshots (torch memory snapshot + /proc/self/maps + graph-pool handle +
# cuMemGetAddressRange probes at k*2^29+MT_OFFSET) from the EngineCore at first_fwd / post_capture / first_split / dec16 / dec32,
# every MT_PERIOD_S, on runner request (pre-/mid-/post-<cell> via $MT_OUT/ctrl) and on a fault log line. Never allocates CUDA memory.
if [ "${MAPTRACE:-0}" = 1 ]; then
  MT_DIR=${MT_DIR:-$W/att2d/maptrace}; DP=/usr/local/lib/python3.12/dist-packages
  [ -n "${MT_OUT:-}" ] || { echo "MAPTRACE=1 needs MT_OUT (host dump dir)" >&2; exit 2; }
  ( cd "$MT_DIR" && sha256sum -c SHA256SUMS ) >&2 || { echo "att2d maptrace sha256 mismatch" >&2; exit 2; }
  mkdir -p "$MT_OUT"; chmod 777 "$MT_OUT"
  MOUNT_ARGS+=(-v "$MT_DIR/att2d_maptrace.py:$DP/att2d_maptrace.py:ro" -v "$MT_DIR/att2d_maptrace.pth:$DP/att2d_maptrace.pth:ro"
               -v "$MT_OUT:/maptrace" -e MEGA_MAPTRACE=1 -e MEGA_MAPTRACE_DIR=/maptrace
               -e MEGA_MAPTRACE_PERIOD_S="${MT_PERIOD_S:-15}" -e MEGA_MAPTRACE_MAX_ENTRIES="${MT_MAX_ENTRIES:-100000}"
               -e MEGA_MAPTRACE_OFFSET="${MT_OFFSET:-0x1F200000}")
fi
if [ "${NOCORE:-0}" = 1 ]; then
  [ "${ATT2B:-0}" = 1 ] && [ "${COREDUMP:-1}" != 0 ] && { echo "NOCORE=1 with ATT2B=1 needs COREDUMP=0" >&2; exit 2; }
  MOUNT_ARGS+=(--ulimit core=0 -e CUDA_ENABLE_COREDUMP_ON_EXCEPTION=0 -e CUDA_ENABLE_CPU_COREDUMP_ON_EXCEPTION=0)
fi
sudo -n sh -c "sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory" 2>/dev/null || true
docker rm -f "$NAME" 2>/dev/null || true
docker run -d --name "$NAME" --gpus "\"device=$GB300\"" \
  --cap-add SYS_NICE --ipc host --network host \
  --ulimit memlock=-1 --ulimit stack=67108864 --cap-add IPC_LOCK --security-opt label=disable \
  -v "$MODEL":/model:ro -v "$CACHE/vllm":/root/.cache/vllm -v "$CACHE/fi":/root/.cache/flashinfer \
  -v "$CACHE/tilelang":/root/.tilelang -v "$CACHE/triton":/root/.triton -v "$CACHE/nv":/root/.nv -v "$CACHE/dj":/root/.dj \
  -v "$W/prof":/prof -v "$LOGDIR":/logs \
  -v "$HOOK/sitecustomize.py":/usr/lib/python3.12/sitecustomize.py:ro -v "$HOOK":/w:ro \
  -v /usr/bin/numactl:/usr/local/bin/numactl:ro --entrypoint /usr/local/bin/numactl \
  "${MOUNT_ARGS[@]}" \
  -e VLLM_LOGGING_LEVEL=INFO -e VLLM_ENGINE_READY_TIMEOUT_S=7200 -e CUDA_LOG_FILE=stderr -e CUDA_DEVICE_ORDER=PCI_BUS_ID -e HF_HUB_OFFLINE=1 \
  -e MEGA_HOOK=/w/mega_peer_hook.py -e MEGA_ROWMAP=/w/$ROWMAP \
  -e VLLM_EXP_PEER_SPINS=${PEER_SPINS:-2000000000} \
  -e MEGA_PEER=2 -e MEGA_PEER_MIN_TOKENS=1 -e VLLM_EXP_PEER2_SMALL=64 -e MEGA_FUSED_SEND=2 \
  -e MEGA_PEER_CHECK=${MEGA_PEER_CHECK:-0} -e MEGA_PEER_CHECK_MIN_T=65 -e MEGA_COLD_TRT=${MEGA_COLD_TRT:-0} -e MEGA_COUNT=${MEGA_COUNT:-} \
  -e MEGA_MHC_OVERLAP=1 -e MEGA_LL_GEMM=${MEGA_LL_GEMM:-1} -e MEGA_FI_TUNE_FILE=${MEGA_FI_TUNE_FILE:-} -e MEGA_NO_MEGA_MHC=0 \
  -e MEGA_SHARE_TOPK=${MEGA_SHARE_TOPK:-0} -e MEGA_POS_I32_ONCE=${MEGA_POS_I32_ONCE:-0} -e MEGA_CAND_COOP=${MEGA_CAND_COOP:-0} \
  -e MEGA_L2_VERIFY=${MEGA_L2_VERIFY:-0} -e MEGA_L2_STATS_EVERY=${MEGA_L2_STATS_EVERY:-0} \
  "$IMAGE" --membind=0 vllm serve \
  --model /model --served-model-name dsv41-flash-uva --trust-remote-code --tensor-parallel-size 1 \
  --moe-backend deep_gemm_mega_moe --enable-expert-parallel \
  --engram-config '{"cpu_offload": true}' \
  --max-model-len "$MAXLEN" --max-num-seqs "$SEQS" --max-num-batched-tokens 8192 \
  --gpu-memory-utilization "$GPU_UTIL" --kv-cache-dtype fp8_ds_mla \
  --tool-call-parser deepseek_v41 --reasoning-parser deepseek_v41 --enable-auto-tool-choice \
  --long-prefill-token-threshold 6144 --enable-prefix-caching \
  --speculative-config "{\"method\":\"dspark\",\"num_speculative_tokens\":$NSPEC,\"num_speculative_tokens_per_batch_size\":$KSCHED,\"draft_sample_method\":\"probabilistic\"$SPEC_EXTRA}" \
  --cudagraph-capture-sizes $CG_SIZES \
  $EXTRA --host 0.0.0.0 --port "$PORT" >/dev/null
nohup docker logs -f "$NAME" > "$LOGDIR/$NAME.log" 2>&1 &
echo "launched $NAME (peer v2, rowmap=$ROWMAP seqs=$SEQS util=$GPU_UTIL maxlen=$MAXLEN overlay=${REPLAY_OVERLAY:-1} ov61161=${OVERLAY_61161:-0} hook=$HOOK l2=${MEGA_SHARE_TOPK:-0}/${MEGA_POS_I32_ONCE:-0}/${MEGA_CAND_COOP:-0} PEER_CHECK=${MEGA_PEER_CHECK:-0} COLD_TRT=${MEGA_COLD_TRT:-0}) log $LOGDIR/$NAME.log"
