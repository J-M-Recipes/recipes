diff -ruN a/include/w1/variants.cuh b/include/w1/variants.cuh
--- a/include/w1/variants.cuh	1969-12-31 18:00:00
+++ b/include/w1/variants.cuh	2026-11-14 21:31:28
@@ -0,0 +1,82 @@
+// Desk I (2026-11-14) DRAFT: compile-time switches for the INCUMBENT w1_attn_ext.so (Pg61 tree kernels/w1-attn).
+// Same switches and same expansions as desk F's FP8 patch (results/F/variants.DRAFT.diff); each moves ONE W1
+// arithmetic behaviour to what the stock FlashMLA decode kernel (vLLM v0.31.0 _flashmla_C, built without
+// --use_fast_math) does. With no -D, every macro expands to the Pg61 expression (same operations, same order).
+//
+//   -DW1_VARIANT_SINK_UNFUSED   exp2 argument of the sink term as round(round(sink*L2E) - m)  (two roundings)
+//   -DW1_VARIANT_SINK_FMA       exp2 argument as one fma(sink, L2E, -m) (forces the form nvcc is expected to emit now)
+//   -DW1_VARIANT_EX2_NOFTZ      every ex2_approx() as ex2.approx.f32 (stock exp2f without fast math) instead of .ftz
+//   -DW1_VARIANT_OSC_DIV_NOFTZ  1/(l + sink term) as div.approx.f32 (__fdividef without fast math) instead of .ftz
+//   -DW1_VARIANT_OUT_DIV_RN     amax/448 as div.rn.f32 (cannot change a data byte without its scale byte)
+//   -DW1_VARIANT_STOCK_ALL      SINK_UNFUSED + EX2_NOFTZ + OSC_DIV_NOFTZ + OUT_DIV_RN together
+//
+// Kernels covered: ss (window-only layers + drafter on the FP8 lane), seq, par, cx, combine (EX2 via ptx.cuh covers
+// every ex2_approx call, split included). F's seq-only W1_DIAG instrumentation is not carried (no ss equivalent).
+#pragma once
+
+#ifdef W1_VARIANT_STOCK_ALL
+#ifndef W1_VARIANT_SINK_UNFUSED
+#define W1_VARIANT_SINK_UNFUSED 1
+#endif
+#ifndef W1_VARIANT_EX2_NOFTZ
+#define W1_VARIANT_EX2_NOFTZ 1
+#endif
+#ifndef W1_VARIANT_OSC_DIV_NOFTZ
+#define W1_VARIANT_OSC_DIV_NOFTZ 1
+#endif
+#ifndef W1_VARIANT_OUT_DIV_RN
+#define W1_VARIANT_OUT_DIV_RN 1
+#endif
+#endif
+
+#if defined(W1_VARIANT_SINK_UNFUSED) && defined(W1_VARIANT_SINK_FMA)
+#error "W1_VARIANT_SINK_UNFUSED and W1_VARIANT_SINK_FMA are mutually exclusive"
+#endif
+
+// ---- sink term argument: stock `attn_sink = sink * CUDART_L2E_F` (behind a nullptr ternary), then
+//      `exp2f(attn_sink - mi)`. Pg61: `sink_l2 = sink * kL2E; ... ex2(sink_l2 - m)` (contractible by nvcc).
+//      Use inside namespace w1 (kL2E from attn_params.cuh).
+#if defined(W1_VARIANT_SINK_UNFUSED)
+#define W1_SINK_ARG(s, m) __fsub_rn(__fmul_rn((s), kL2E), (m))
+#elif defined(W1_VARIANT_SINK_FMA)
+#define W1_SINK_ARG(s, m) __fmaf_rn((s), kL2E, -(m))
+#else
+#define W1_SINK_ARG(s, m) ((s) * kL2E - (m))
+#endif
+
+// ---- ex2: stock exp2f (non-fast-math) = ex2.approx.f32; Pg61 = ex2.approx.ftz.f32
+#ifdef W1_VARIANT_EX2_NOFTZ
+#define W1_EX2_ASM "ex2.approx.f32 %0, %1;"
+#else
+#define W1_EX2_ASM "ex2.approx.ftz.f32 %0, %1;"
+#endif
+
+// ---- output scale 1/(l + sink term): stock __fdividef (non-fast-math) = div.approx.f32; Pg61 = .ftz
+#ifdef W1_VARIANT_OSC_DIV_NOFTZ
+#define W1_OSC_DIV_ASM "div.approx.f32 %0, %1, %2;"
+#else
+#define W1_OSC_DIV_ASM "div.approx.ftz.f32 %0, %1, %2;"
+#endif
+
+// ---- sf = amax / 448: stock `/` without fast math = div.rn.f32; Pg61 = div.approx.ftz.f32
+#ifdef W1_VARIANT_OUT_DIV_RN
+#define W1_OUT_DIV_ASM "div.rn.f32 %0, %1, %2;"
+#else
+#define W1_OUT_DIV_ASM "div.approx.ftz.f32 %0, %1, %2;"
+#endif
+
+#ifdef W1_VARIANT_SINK_UNFUSED
+#pragma message("W1 desk-I variant active: SINK_UNFUSED")
+#endif
+#ifdef W1_VARIANT_SINK_FMA
+#pragma message("W1 desk-I variant active: SINK_FMA")
+#endif
+#ifdef W1_VARIANT_EX2_NOFTZ
+#pragma message("W1 desk-I variant active: EX2_NOFTZ")
+#endif
+#ifdef W1_VARIANT_OSC_DIV_NOFTZ
+#pragma message("W1 desk-I variant active: OSC_DIV_NOFTZ")
+#endif
+#ifdef W1_VARIANT_OUT_DIV_RN
+#pragma message("W1 desk-I variant active: OUT_DIV_RN")
+#endif
