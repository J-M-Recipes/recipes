@@ -0,0 +1,140 @@
+"""CPU-testable cache-layout contract for W1 decode attention.
+
+The CUDA extension receives :class:`CacheFormat` explicitly.  Record byte
+counts are validation inputs at the Python boundary, not an in-kernel format
+inference mechanism.
+"""
+
+from __future__ import annotations
+
+from enum import IntEnum
+from typing import Mapping
+
+
+FP4_PAYLOAD_BYTES = 256
+FP4_SCALE_BYTES = 32
+FP8_PAYLOAD_BYTES = 512
+FP8_SCALE_BYTES = 16
+
+MAX_SQ = 16
+MAX_SQ_CX = 76
+MAX_SQ_SWA = 24
+
+
+class CacheFormat(IntEnum):
+    NONE = 0
+    FP4 = 1
+    FP8 = 2
+
+
+def record_layout(comp_format: CacheFormat) -> tuple[int, int, int]:
+    """Return ``(payload bytes, scale bytes, total record bytes)``."""
+    if comp_format == CacheFormat.FP4:
+        return FP4_PAYLOAD_BYTES, FP4_SCALE_BYTES, FP4_PAYLOAD_BYTES + FP4_SCALE_BYTES
+    if comp_format == CacheFormat.FP8:
+        return FP8_PAYLOAD_BYTES, FP8_SCALE_BYTES, FP8_PAYLOAD_BYTES + FP8_SCALE_BYTES
+    raise ValueError("no compressed-cache record for CacheFormat.NONE")
+
+
+def resolve_slot_address(
+    comp_format: CacheFormat,
+    *,
+    page_tokens: int,
+    block_stride_bytes: int,
+    logical_index: int,
+    valid_length: int,
+    global_index: int,
+) -> tuple[int, int] | None:
+    """CPU model of the existing loader's data/scale plane addressing.
+
+    Negative indices and slots masked by the per-row valid length never form an
+    address.  Cache rows are stored as a payload plane followed by a scale plane
+    within each page, not as physically interleaved 288/528-byte records.
+    """
+    payload_bytes, scale_bytes, record_bytes = record_layout(comp_format)
+    if page_tokens <= 0 or block_stride_bytes < page_tokens * record_bytes:
+        raise ValueError("invalid page or block stride")
+    if logical_index >= valid_length or global_index < 0:
+        return None
+    block, offset = divmod(global_index, page_tokens)
+    page_base = block * block_stride_bytes
+    data = page_base + offset * payload_bytes
+    scale = page_base + page_tokens * payload_bytes + offset * scale_bytes
+    return data, scale
+
+
+def compressed_fp8_enabled(environ: Mapping[str, str] | None = None) -> bool:
+    """Return the separate, exact opt-in.  Missing or non-``1`` is off."""
+    if environ is None:
+        import os
+
+        environ = os.environ
+    return environ.get("DS41_W1_COMPRESSED_FP8") == "1"
+
+
+def classify_compressed_layout(
+    *,
+    present: bool,
+    byte_dtype: bool,
+    ndim: int,
+    record_bytes: int,
+    token_stride_bytes: int,
+    allow_fp8: bool,
+) -> CacheFormat | None:
+    """Classify a compressed-cache record and return its explicit ABI format.
+
+    ``None`` means malformed or disabled and must select the stock fallback.
+    ``CacheFormat.NONE`` means that no compressed cache was supplied.
+    Page extents, strides, and alignment are validated separately by
+    :func:`cache_layout_is_valid` before W1 is selected.
+    """
+    if not present:
+        return CacheFormat.NONE
+    if not byte_dtype or ndim != 3:
+        return None
+    if record_bytes == FP4_PAYLOAD_BYTES + FP4_SCALE_BYTES and token_stride_bytes == record_bytes:
+        return CacheFormat.FP4
+    if (allow_fp8 and record_bytes == FP8_PAYLOAD_BYTES + FP8_SCALE_BYTES
+            and token_stride_bytes == record_bytes):
+        return CacheFormat.FP8
+    return None
+
+
+def cache_layout_is_valid(
+    *,
+    num_pages: int,
+    page_tokens: int,
+    record_bytes: int,
+    block_stride_bytes: int,
+    token_stride_bytes: int,
+    byte_stride: int,
+    base_address: int,
+) -> bool:
+    """Validate metadata needed by the page-plane loaders without reading device data."""
+    return (
+        num_pages > 0
+        and page_tokens > 0
+        and byte_stride == 1
+        and token_stride_bytes == record_bytes
+        and block_stride_bytes >= page_tokens * record_bytes
+        and block_stride_bytes % 16 == 0
+        and base_address % 16 == 0
+    )
+
+
+def select_mode(rows: int, comp_format: CacheFormat) -> str:
+    """Return W1's validated execution mode, or ``stock``.
+
+    Cluster/CX compressed-FP8 is deliberately not selected in this draft: its
+    later-pair loader uses an FP4-sized register row and its FP8 load addresses
+    the SWA cache.  FP4 coverage is unchanged.
+    """
+    if rows <= 0:
+        return "stock"
+    if comp_format == CacheFormat.NONE:
+        return "ss" if rows <= MAX_SQ_SWA else "stock"
+    if rows <= MAX_SQ:
+        return "bitwise"
+    if comp_format == CacheFormat.FP4 and rows <= MAX_SQ_CX:
+        return "cx"
+    return "stock"
