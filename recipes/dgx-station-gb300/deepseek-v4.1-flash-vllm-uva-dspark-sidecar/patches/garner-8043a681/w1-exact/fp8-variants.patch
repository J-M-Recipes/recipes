diff -ruN a/include/w1/variants.cuh b/include/w1/variants.cuh
--- a/include/w1/variants.cuh	1969-12-31 18:00:00
+++ b/include/w1/variants.cuh	2026-11-14 16:19:24
@@ -0,0 +1,103 @@
+// Desk F (2026-11-14) DRAFT: compile-time switches that each move ONE W1 arithmetic behaviour to what the stock
+// FlashMLA decode kernel (vLLM v0.31.0 _flashmla_C, FlashMLA @0eee43b1, built without --use_fast_math) does.
+// With no -D given, every macro below expands to the W13 expression unchanged (same operations, same order).
+//
+//   -DW1_VARIANT_SINK_UNFUSED   exp2 argument of the sink term as round(round(sink*L2E) - m)  (two roundings)
+//   -DW1_VARIANT_SINK_FMA       exp2 argument as one fma(sink, L2E, -m) (forces what nvcc is expected to emit now)
+//   -DW1_VARIANT_EX2_NOFTZ      every ex2_approx() as ex2.approx.f32 (stock exp2f without fast math) instead of .ftz
+//   -DW1_VARIANT_OSC_DIV_NOFTZ  1/(l + sink term) as div.approx.f32 (__fdividef without fast math) instead of .ftz
+//   -DW1_VARIANT_OUT_DIV_RN     amax/448 as div.rn.f32 (desk D's fix; cannot change a data byte without its scale)
+//   -DW1_VARIANT_STOCK_ALL      SINK_UNFUSED + EX2_NOFTZ + OSC_DIV_NOFTZ + OUT_DIV_RN together
+//
+//   -DW1_DIAG -DW1_DIAG_ROW=r -DW1_DIAG_HEAD=h -DW1_DIAG_DIM=d [-DW1_DIAG_WHAT=0|1|2]
+//       seq kernel (plan bitwise_seq) only: writes three little-endian 32-bit words into bytes 0..11 of row 0's fp8
+//       output for element (row r, head h, dim d); the row-0 task then writes only bytes 12..15 of its first 16 B.
+//       WHAT 0: [pre-quantization float y*mlt fed to cvt.rn.satfinite.e4m3] [group amax = max(1e-4, amax_raw*osc)]
+//               [mlt = osc * 2^-exp_sf, the multiplier; osc = mlt * 2^exp_sf exactly]
+//       WHAT 1: [y = raw O element after inverse RoPE, before scaling] [osc] [amax_raw of the 32-dim group]
+//       WHAT 2: [m (final running max, log2 units)] [exp2 argument sink*L2E - m as this build computes it] [l]
+//   Diagnostic builds are for the offline fixture only; never install one in a served tree.
+#pragma once
+
+#ifdef W1_VARIANT_STOCK_ALL
+#ifndef W1_VARIANT_SINK_UNFUSED
+#define W1_VARIANT_SINK_UNFUSED 1
+#endif
+#ifndef W1_VARIANT_EX2_NOFTZ
+#define W1_VARIANT_EX2_NOFTZ 1
+#endif
+#ifndef W1_VARIANT_OSC_DIV_NOFTZ
+#define W1_VARIANT_OSC_DIV_NOFTZ 1
+#endif
+#ifndef W1_VARIANT_OUT_DIV_RN
+#define W1_VARIANT_OUT_DIV_RN 1
+#endif
+#endif
+
+#if defined(W1_VARIANT_SINK_UNFUSED) && defined(W1_VARIANT_SINK_FMA)
+#error "W1_VARIANT_SINK_UNFUSED and W1_VARIANT_SINK_FMA are mutually exclusive"
+#endif
+
+// ---- sink term argument: stock kernel.cuh:341-342 `attn_sink = sink * CUDART_L2E_F` (behind a nullptr ternary),
+//      then `exp2f(attn_sink - mi)`. W13: `sink_l2 = sink * kL2E; ... ex2(sink_l2 - m)` (contractible by nvcc).
+//      Use inside namespace w1 (kL2E from attn_params.cuh).
+#if defined(W1_VARIANT_SINK_UNFUSED)
+#define W1_SINK_ARG(s, m) __fsub_rn(__fmul_rn((s), kL2E), (m))
+#elif defined(W1_VARIANT_SINK_FMA)
+#define W1_SINK_ARG(s, m) __fmaf_rn((s), kL2E, -(m))
+#else
+#define W1_SINK_ARG(s, m) ((s) * kL2E - (m))
+#endif
+
+// ---- ex2: stock exp2f (non-fast-math) = ex2.approx.f32; W13 = ex2.approx.ftz.f32
+#ifdef W1_VARIANT_EX2_NOFTZ
+#define W1_EX2_ASM "ex2.approx.f32 %0, %1;"
+#else
+#define W1_EX2_ASM "ex2.approx.ftz.f32 %0, %1;"
+#endif
+
+// ---- output scale 1/(l + sink term): stock __fdividef (non-fast-math) = div.approx.f32; W13 = .ftz
+#ifdef W1_VARIANT_OSC_DIV_NOFTZ
+#define W1_OSC_DIV_ASM "div.approx.f32 %0, %1, %2;"
+#else
+#define W1_OSC_DIV_ASM "div.approx.ftz.f32 %0, %1, %2;"
+#endif
+
+// ---- sf = amax / 448: stock `/` without fast math = div.rn.f32; W13 = div.approx.ftz.f32
+#ifdef W1_VARIANT_OUT_DIV_RN
+#define W1_OUT_DIV_ASM "div.rn.f32 %0, %1, %2;"
+#else
+#define W1_OUT_DIV_ASM "div.approx.ftz.f32 %0, %1, %2;"
+#endif
+
+#ifdef W1_VARIANT_SINK_UNFUSED
+#pragma message("W1 desk-F variant active: SINK_UNFUSED")
+#endif
+#ifdef W1_VARIANT_SINK_FMA
+#pragma message("W1 desk-F variant active: SINK_FMA")
+#endif
+#ifdef W1_VARIANT_EX2_NOFTZ
+#pragma message("W1 desk-F variant active: EX2_NOFTZ")
+#endif
+#ifdef W1_VARIANT_OSC_DIV_NOFTZ
+#pragma message("W1 desk-F variant active: OSC_DIV_NOFTZ")
+#endif
+#ifdef W1_VARIANT_OUT_DIV_RN
+#pragma message("W1 desk-F variant active: OUT_DIV_RN")
+#endif
+
+#ifdef W1_DIAG
+#if !defined(W1_DIAG_ROW) || !defined(W1_DIAG_HEAD) || !defined(W1_DIAG_DIM)
+#error "W1_DIAG needs -DW1_DIAG_ROW=<row> -DW1_DIAG_HEAD=<0..63> -DW1_DIAG_DIM=<0..511>"
+#endif
+#ifndef W1_DIAG_WHAT
+#define W1_DIAG_WHAT 0
+#endif
+#pragma message("W1 desk-F DIAG build (seq kernel writes 12 diagnostic bytes into row 0) - fixture use only")
+static_assert(W1_DIAG_ROW >= 0 && W1_DIAG_HEAD >= 0 && W1_DIAG_HEAD < 64 && W1_DIAG_DIM >= 0 && W1_DIAG_DIM < 512,
+              "W1_DIAG target out of range");
+static_assert(W1_DIAG_WHAT >= 0 && W1_DIAG_WHAT <= 2, "W1_DIAG_WHAT must be 0, 1 or 2");
+static_assert((long long)W1_DIAG_ROW * 32768 + (W1_DIAG_HEAD / 8) * 4096 + (W1_DIAG_DIM / 32) * 256 +
+                      (W1_DIAG_HEAD % 8) * 32 + (W1_DIAG_DIM % 32) >= 12,
+              "W1_DIAG target byte lies inside the 12 diagnostic bytes of row 0");
+#endif
